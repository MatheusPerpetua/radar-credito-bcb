# Projeto GCP onde ficam os datasets do BigQuery
GCP_PROJECT=seu-projeto-gcp
BQ_LOCATION=southamerica-east1
BQ_DATASET_RAW=raw_bcb

# dbt: "dev" usa suas credenciais locais (gcloud auth application-default login);
# "prod" usa a conta de serviço apontada em DBT_KEYFILE
DBT_TARGET=dev
DBT_DATASET=radar_dev
# DBT_KEYFILE=/caminho/para/conta-de-servico.json

# Prefect Cloud (opcional — sem isso o Prefect roda com servidor local temporário)
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<conta>/workspaces/<workspace>
# PREFECT_API_KEY=
